# Hedera Network
HEDERA_NETWORK=testnet
HEDERA_ACCOUNT_ID=0.0.XXXXXX
HEDERA_PRIVATE_KEY=302e...

# LazyLotto MCP Endpoint
LAZYLOTTO_MCP_URL=https://dapp.lazysuperheroes.com/api/mcp
LAZYLOTTO_MCP_API_KEY=ll_xxxxx

# LazyLotto Contract Addresses (testnet)
LAZYLOTTO_CONTRACT_ID=0.0.8463358
LAZYLOTTO_STORAGE_ID=0.0.8463338
LAZYLOTTO_POOL_MANAGER_ID=0.0.8463369
LAZY_GAS_STATION_ID=0.0.8011801
# LAZY token ID (testnet: 0.0.8011209, mainnet: 0.0.1311037)
LAZY_TOKEN_ID=0.0.8011209

# Owner wallet — receives prizes and withdrawals
OWNER_EOA=0.0.XXXXXX

# Strategy (conservative | balanced | aggressive | path to custom JSON)
STRATEGY=balanced

# Delegate Registry (optional — for --audit win rate boost checks)
DELEGATE_REGISTRY_ID=0.0.XXXXXX
# Comma-separated LSH collection token IDs to check for delegation
LSH_TOKEN_IDS=0.0.XXXXXX,0.0.YYYYYY

# Multi-User Custodial Mode (optional)
MULTI_USER_ENABLED=false
RAKE_DEFAULT_PERCENT=5.0
RAKE_MIN_PERCENT=2.0
RAKE_MAX_PERCENT=5.0
DEPOSIT_POLL_INTERVAL_MS=10000
MAX_USER_BALANCE=10000
HCS20_TOPIC_ID=
HCS20_TICK=LLCRED

# MCP Server Authentication.
# Single-user CLI / Claude Desktop: gates the local MCP server so other
# processes on your machine can't drive the agent. Confers the highest
# tier (operator) when set and matched.
# Hosted multi-user mode: this var is IGNORED. Wallet auth via
# OPERATOR_ACCOUNTS / ADMIN_ACCOUNTS is the only path to a privileged
# tier. A leaked or misconfigured value is a no-op, not an escalation.
MCP_AUTH_TOKEN=

# Restrict operator fee withdrawals to this address (optional)
OPERATOR_WITHDRAW_ADDRESS=

# Per-user daily withdrawal velocity cap (HBAR equivalent, default 1000)
# Bounds blast radius if a user session is compromised.
WITHDRAWAL_DAILY_CAP_HBAR=1000

# SaucerSwap Price API (mainnet only)
SAUCERSWAP_API_KEY=

# HOL Registry (optional)
HOL_API_KEY=

# ── Hosted (Vercel) Mode ──────────────────────────────────────────
# Required when running as the multi-user hosted agent on Vercel.

# Comma-separated allow list of origins permitted to call the API
# cross-origin. Wildcard '*' is rejected in production (stripped to
# empty). If unset in production, the API still runs but rejects all
# cross-origin callers — same-origin dashboard requests still work,
# but external browsers and alternate frontends will be blocked.
# A loud boot warning fires in Vercel logs when unset — check there
# if cross-origin requests unexpectedly fail.
# Testnet:  AUTH_PAGE_ORIGIN=https://testnet-agent.lazysuperheroes.com
# Mainnet:  AUTH_PAGE_ORIGIN=https://agent.lazysuperheroes.com
# Multiple: AUTH_PAGE_ORIGIN=https://a.example.com,https://b.example.com
AUTH_PAGE_ORIGIN=

# Comma-separated Hedera account IDs that get the 'admin' tier on auth.
# Omit to disable admin tier entirely. These accounts can refund users,
# view dead letters, and access the admin dashboard.
ADMIN_ACCOUNTS=

# Comma-separated Hedera account IDs that get the 'operator' tier on auth.
# Operator is a strict superset of admin (fees, reconcile, health, kill
# switch, fee withdrawal). Omit to disable operator-via-wallet entirely
# in hosted mode (the legacy MCP_AUTH_TOKEN shared secret is ignored
# when MULTI_USER_ENABLED=true).
OPERATOR_ACCOUNTS=

# Upstash Redis — required for sessions and ledger persistence on Vercel.
# Vercel auto-injects these when you connect a Vercel-managed Upstash DB.
# Local dev: leave both unset to use the in-memory fallback.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or use the Upstash-native names (either pair works):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public agent base URL (used by the discover endpoint and verify route)
NEXT_PUBLIC_APP_URL=https://testnet-agent.lazysuperheroes.com

# Override the MCP endpoint URL returned by /api/auth/verify
# (defaults to ${NEXT_PUBLIC_APP_URL}/api/mcp).
AGENT_MCP_URL=

# Override the Verification Directus collection name (default: 'Verification')
VERIFICATION_TABLE=

# ── AI Chat (Hedera Agent Kit) ────────────────────────────────────
# Opt-in chat interface backed by the Hedera Agent Kit. Default OFF.
# When CHAT_ENABLED is not 'true', /api/chat returns 404 and the kit
# is never loaded (the route dynamic-imports its handler behind the flag).
CHAT_ENABLED=false
# Chat model (via @ai-sdk/anthropic). Haiku 4.5 = cheapest capable tier for this
# scoped tool-routing chat; set claude-sonnet-4-6 for more headroom.
CHAT_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
# Cost guardrails (keep the demo within budget). All optional; defaults shown.
CHAT_MAX_OUTPUT_TOKENS=800       # max model output tokens per turn
CHAT_MAX_INPUT_CHARS=1200        # reject a single user message longer than this
CHAT_MAX_HISTORY_MESSAGES=10     # context window: keep only the last N messages
CHAT_MAX_STEPS=4                 # max tool-call steps per turn
CHAT_DAILY_MESSAGE_LIMIT=40      # max chat messages per user per rolling 24h
# Let the chat agent START A PLAY SESSION (the only mutating chat tool), behind a
# two-step confirmation. Default OFF — chat is read-only unless this is 'true'.
# The play still routes through the audited MCP → custodial path; the kit's
# mutating plugins are never loaded. Withdrawals stay on the dashboard.
CHAT_ALLOW_PLAY=false

# ── x402 Payment Gate (ALTERNATIVE channel) ───────────────────────
# Pay-per-capability HBAR gate via the x402-on-Hedera scheme
# (@x402/core + @x402/hedera). This is an ALTERNATIVE way to take
# payment — it does NOT replace the deposit-time rake. Default OFF:
# when X402_ENABLED is not 'true', the gated capability is served
# transparently with no payment required.
X402_ENABLED=false
# x402 facilitator (verify + settle). Blocky402 testnet is keyless.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
# Hedera account (0.0.x) that receives payments. Defaults to HEDERA_ACCOUNT_ID.
X402_PAY_TO=
# Rake holiday: priced in USD; payable in USDC (1:1) OR the live HBAR
# equivalent. Pay once → 0% rake for the window. Default: $5.00 for 30 days.
X402_RAKE_HOLIDAY_PRICE_USD_CENTS=500
X402_RAKE_HOLIDAY_DAYS=30
# HBAR payments are quoted from the live mirror-node exchange rate. Accept a
# payment worth at least this fraction of the USD price, to absorb rate drift
# between quote and settlement (0.97 = allow 3% slippage). Config-driven.
X402_PRICE_MIN_ACCEPTED_FRACTION=0.97
# Mirror node base URL for the HBAR<->USD rate (default: network-aware).
X402_MIRROR_NODE_URL=
# HTS token id for USDC payments (default: testnet 0.0.429274 / mainnet 0.0.456858).
X402_USDC_TOKEN_ID=
# Facilitator fee-payer account that co-signs gas — MUST match the facilitator.
# Blocky402 testnet = 0.0.7162784; set for mainnet / a self-hosted facilitator.
X402_FEE_PAYER=
# x402 payment validity window (seconds).
X402_MAX_TIMEOUT_SECONDS=120
# Optionally record x402 payments to the HCS-20 audit trail (additive event).
X402_RECORD_TO_HCS20=false
